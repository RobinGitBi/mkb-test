model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: sv-SE
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensionstabeller

	annotation PBI_QueryGroupOrder = 0

queryGroup Faktatabeller

	annotation PBI_QueryGroupOrder = 1

/// Fel i frågor som lästes in på 2024-06-03 08:38:33.
queryGroup 'Frågefel – 2024-06-03 08:38:33'

	annotation PBI_QueryGroupOrder = 2

/// Fel i frågor som lästes in på 2025-04-25 15:03:10.
queryGroup 'Frågefel – 2025-04-25 15:03:10'

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Mätvärde","Kalender","Budget - for append","Yta per segment och kostnadsställe","Företag","Konto","Kostnadsställe","Funktion","Leverantör","Projekt","Segment","Slag","Vertyp","Kund","PNLStructure","Uppföljning","KoddelLG","Beställarlistan for append","Fastighet","ViewFactFte","ViewDimAnställdSCD2","ViewFactFteFrånvaroJustering","ViewFactFteJusteradPrognos","ViewDimLöneKategori","ViewRLSKostnadsställe"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["CalcGroup","DevMode"]

ref table Företag
ref table Konto
ref table Kostnadsställe
ref table Segment
ref table Slag
ref table Projekt
ref table Kalender
ref table PNLStructure
ref table Mätvärde
ref table Vertyp
ref table Leverantör
ref table Kund
ref table Uppföljning
ref table Funktion
ref table KoddelLG
ref table 'Yta per segment och kostnadsställe'
ref table Fastighet
ref table 'Mätvärden Personal'
ref table ViewFactFte
ref table ViewDimAnställdSCD2
ref table ViewFactFteFrånvaroJustering
ref table ViewFactFteJusteradPrognos
ref table ViewDimLöneKategori
ref table ViewRLSKostnadsställe

ref role RLS
ref role FullRLS

ref perspective AdHoc

ref cultureInfo en-US

