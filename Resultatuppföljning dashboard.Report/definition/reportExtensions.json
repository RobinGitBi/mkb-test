{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "Mätvärde",
      "measures": [
        {
          "name": "Andel ND Uppföljning",
          "dataType": "Double",
          "expression": "\n\nVAR ND = CALCULATE( [Utfall ÅTD], 'Uppföljning'[Uppföljning] = \"ND\")\n\nVAR Total = [Utfall ÅTD]\n\nVAR Result = DIVIDE( ND, Total, BLANK())\n\nRETURN Result + 0",
          "formatString": "0\\ %;-0\\ %;0\\ %",
          "references": {
            "measures": [
              {
                "entity": "Mätvärde",
                "name": "Utfall ÅTD"
              }
            ]
          }
        },
        {
          "name": "Andel ND Leverantör",
          "dataType": "Double",
          "expression": "\n\nVAR ND = CALCULATE( [Utfall ÅTD], 'Leverantör'[Leverantör] = \"ND\")\n\nVAR Total = [Utfall ÅTD]\n\nVAR Result = DIVIDE( ND, Total, BLANK())\n\nRETURN Result + 0",
          "formatString": "0\\ %;-0\\ %;0\\ %",
          "references": {
            "measures": [
              {
                "entity": "Mätvärde",
                "name": "Utfall ÅTD"
              }
            ]
          }
        },
        {
          "name": "Andel ND Kostnadsställe",
          "dataType": "Double",
          "expression": "\n\nVAR ND = CALCULATE( [Utfall ÅTD], 'Kostnadsställe'[Kostnadsställe] = \"ND\")\n\nVAR Total = [Utfall ÅTD]\n\nVAR Result = DIVIDE( ND, Total, BLANK())\n\nRETURN Result + 0",
          "formatString": "0\\ %;-0\\ %;0\\ %",
          "references": {
            "measures": [
              {
                "entity": "Mätvärde",
                "name": "Utfall ÅTD"
              }
            ]
          }
        },
        {
          "name": "Andel ND Slag",
          "dataType": "Double",
          "expression": "\n\nVAR ND = CALCULATE( [Utfall ÅTD], Slag[Slag] = \"ND\")\n\nVAR Total = [Utfall ÅTD]\n\nVAR Result = DIVIDE( ND, Total, BLANK())\n\nRETURN Result + 0",
          "formatString": "0\\ %;-0\\ %;0\\ %",
          "references": {
            "measures": [
              {
                "entity": "Mätvärde",
                "name": "Utfall ÅTD"
              }
            ]
          }
        },
        {
          "name": "Diff T2 Innev. År vs T0 Nästa År",
          "dataType": "Double",
          "expression": "\r\n\r\n[T2 helår] -\r\nCALCULATE([T0]\r\n, NEXTYEAR(Kalender[Datum]))",
          "formatString": "#,0",
          "displayFolder": "Differenser",
          "references": {
            "measures": [
              {
                "entity": "Mätvärde",
                "name": "T2 helår"
              },
              {
                "entity": "Mätvärde",
                "name": "T0"
              }
            ]
          }
        },
        {
          "name": "Diff% T2 Innev. vs T0 Nästa År",
          "dataType": "Double",
          "expression": "\r\n\r\nDIVIDE([Diff T2 Innev. År vs T0 Nästa År],\r\nCALCULATE([T0]\r\n, NEXTYEAR(Kalender[Datum])))",
          "formatString": "0.00\\ %;-0.00\\ %;0.00\\ %",
          "displayFolder": "Differenser",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Mätvärde",
                "name": "Diff T2 Innev. År vs T0 Nästa År"
              },
              {
                "entity": "Mätvärde",
                "name": "T0"
              }
            ]
          }
        },
        {
          "name": "Diff T1 - T0 Helår",
          "dataType": "Double",
          "expression": "\r\n\r\nIF(NOT ISBLANK([T1 helår]) || NOT ISBLANK([T0]), [T1 helår] -\r\n[T0])",
          "formatString": "#,0",
          "displayFolder": "Differenser",
          "references": {
            "measures": [
              {
                "entity": "Mätvärde",
                "name": "T1 helår"
              },
              {
                "entity": "Mätvärde",
                "name": "T0"
              }
            ]
          }
        },
        {
          "name": "Diff T1 Innev. År vs T1 Nästa År %",
          "dataType": "Double",
          "expression": "\r\n\r\nDIVIDE([Diff T1 - T0 Helår],\r\nCALCULATE([T1]\r\n, NEXTYEAR(Kalender[Datum])))",
          "displayFolder": "Differenser",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Mätvärde",
                "name": "Diff T1 - T0 Helår"
              },
              {
                "entity": "Mätvärde",
                "name": "T1"
              }
            ]
          }
        },
        {
          "name": "Diff T1 Innev. År vs T2 Nästa År",
          "dataType": "Double",
          "expression": "\r\n\r\n[T1 helår] -\r\nCALCULATE([T1]\r\n, NEXTYEAR(Kalender[Datum]))",
          "displayFolder": "Differenser",
          "references": {
            "measures": [
              {
                "entity": "Mätvärde",
                "name": "T1 helår"
              },
              {
                "entity": "Mätvärde",
                "name": "T1"
              }
            ]
          }
        },
        {
          "name": "Diff% T1 - T0 Helår",
          "dataType": "Double",
          "expression": "\r\n\r\nDIVIDE([Diff T1 - T0 Helår], [T1 helår])",
          "formatString": "0.0\\ %;-0.0\\ %;0.0\\ %",
          "displayFolder": "Differenser",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "Mätvärde",
                "name": "Diff T1 - T0 Helår"
              },
              {
                "entity": "Mätvärde",
