	measure 'Format antal FTE nästa år' =
			IF(
			    SELECTEDVALUE(Kalender[MånadNr]) < 9, CONCATENATE("Antal FTE ", SELECTEDVALUE(Kalender[År])) -- Fram till september tittar vi på nuvarande år
			    , CONCATENATE("Antal FTE ", CONVERT(SELECTEDVALUE(Kalender[År]) + 1, STRING)) -- september och framåt är nästkommande år
			)
