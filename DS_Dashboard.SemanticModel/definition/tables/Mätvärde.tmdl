	measure 'Antal FTE fg Månad Fryst' = ```
			-- försöker få till en beräkning på förra körningen av FTE. Inte helt lätt eftersom data bryts 20:e
			
			        VAR fte_manad = SUM('Fryst FTE'[Antal FTE månad])
			        VAR sysselsattning = AVERAGE('Fryst FTE'[Tjänstgöringsgrad])
			
			        RETURN 
			        
			        IF(DAY(TODAY()) < 20, 
			            CALCULATE(
			            fte_manad * sysselsattning,
			            KEEPFILTERS('Fryst FTE'[Frysdatum] = 2024-09-20) -- DATEADD(Kalender[Datum], -2, MONTH))
			            ),       
			            CALCULATE(
			            fte_manad * sysselsattning,
			            DATEADD(Kalender[Datum], -3, MONTH)
			            )
			        )
			        
			```
		formatString: 0
		displayFolder: FTE
		lineageTag: fce76861-2470-45b7-b99f-3607d49c4788

	measure 'Utfall FTE' =
			
			
