	measure 'Antal anställda Fryst' = ```
			
			VAR nuvarande_ar = IF(ISBLANK(SELECTEDVALUE(Kalender[År])), YEAR(TODAY()), SELECTEDVALUE(Kalender[År])) -- Denna måste läggas till eftersom man vill att "icke-val" på kalenderdimensionen ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			VAR nuvarande = IF(ISBLANK(SELECTEDVALUE(Kalender[MånadNr])), MONTH(TODAY()), SELECTEDVALUE(Kalender[MånadNr])) -- Denna måste läggas till eftersom man vill att "icke-val" på kalenderdimensionen ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			VAR yearmonth = CONVERT(CONCATENATE(nuvarande_ar, 
			                    CONCATENATE("-", 
			                        CONCATENATE(IF(
			                            nuvarande < 10, CONCATENATE("0", nuvarande), nuvarande), "-01")
			                            )), DATETIME)
			
			-- komplicerad logik för att kunna filtrera bort alla från urvalet som har avgångsdatum innan vald månad. Ytterligare komplext eftersom man vill att "icke-val" på månad ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			-- Nexer rekommenderade att istället ha ett separat mått för ackumulerat utfall eftersom det blir mer användarvänligt än att det byter mellan ackumulerat och månadsutfall beroende på om man valt månad eller inte. Pernilla K instisterade på att "verksamheten vill ha det så". 
			
			RETURN
			
			CALCULATE(
			    DISTINCTCOUNT('Fryst FTE'[ANST_NR]),
			    KEEPFILTERS('Fryst FTE'[Avgångsdatum] > yearmonth || ISBLANK('Fryst FTE'[Avgångsdatum]))
			)
			
			-- John Agebrand, Nexer Insight 2025-04-24
			
			/*
			VAR yearmonth = CONVERT(CONCATENATE(SELECTEDVALUE(Kalender[År]), 
			                    CONCATENATE("-", 
			                        CONCATENATE(IF(SELECTEDVALUE(Kalender[MånadNr]) < 10, CONCATENATE("0", SELECTEDVALUE(Kalender[MånadNr])), SELECTEDVALUE(Kalender[MånadNr])), "-01")
			)), DATETIME)
			
			-- komplicerad logik för att kunna filtrera bort alla från urvalet som har avgångsdatum innan vald månad
			
			RETURN
			
			CALCULATE(
			    DISTINCTCOUNT('Fryst FTE'[ANST_NR]),
			    KEEPFILTERS(CONVERT('Fryst FTE'[Avgångsdatum], DATETIME) > yearmonth || ISBLANK('Fryst FTE'[Avgångsdatum]))
			)
			*/
			```
		formatString: 0
		displayFolder: FTE
		lineageTag: e8cf3120-83d7-49ca-a9c1-390f1a27b3e8

	measure 'Antal FTE ack' = ```
			
