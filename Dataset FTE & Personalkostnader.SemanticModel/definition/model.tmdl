model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: sv-SE
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensionstabeller

	annotation PBI_QueryGroupOrder = 0

queryGroup Faktatabeller

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Mätvärde","Kalender","Kostnadsställe","Lönekategori","Anställd SCD2","FTE Utfall","FTE Prognos","FTE Frånvaro Justering","RLS Kostnadsställe"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["CalcGroup","DevMode"]

ref table Kostnadsställe
ref table Kalender
ref table Mätvärde
ref table 'FTE Utfall'
ref table 'Anställd SCD2'
ref table 'FTE Frånvaro Justering'
ref table 'FTE Prognos'
ref table Lönekategori
ref table 'RLS Kostnadsställe'

ref role RLS
ref role FullRLS

ref perspective AdHoc

ref cultureInfo en-US

