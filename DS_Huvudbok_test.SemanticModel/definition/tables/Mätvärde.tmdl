	measure 'Antal FTE Total' = ```
			-- den här summerar antalet FTE korrekt
			            VAR fte_next_year = SUM(FTE[Antal månader nästa år])
			            VAR sysselsattning = AVERAGE(FTE[Tjänstgöringsgrad])
			            
			            RETURN 
			            DIVIDE(SUMX(FTE, fte_next_year * sysselsattning) , 12 , 0)
			```
		displayFolder: FTE
		lineageTag: bf38a671-9629-4514-a196-ed29acfb2fa3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Antal FTE' =
			CALCULATE(
			                DIVIDE(
			                    SUM(FTE[Tjänstgöringsgrad]) * SUM(FTE[Antal månader nästa år]), 12, 0
			                    )
			)
		displayFolder: FTE
		lineageTag: d2bbfbcc-168f-43cf-a4f6-e5e2ffcf3619

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Format antal FTE nästa år' =
			IF(
			    SELECTEDVALUE(Kalender[MånadNr]) < 9, CONCATENATE("Antal FTE ", SELECTEDVALUE(Kalender[År])) -- Fram till september tittar vi på nuvarande år
			    , CONCATENATE("Antal FTE ", CONVERT(SELECTEDVALUE(Kalender[År]) + 1, STRING)) -- september och framåt är nästkommande år
			)
		displayFolder: FTE
		lineageTag: ee65b96a-ed43-4794-8074-e9d3d9ae580e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Format lönekostnad nästa år' =
			IF(
			    SELECTEDVALUE(Kalender[Månadnr]) < 9, CONCATENATE("Total lönekostnad ", SELECTEDVALUE(Kalender[År])) -- Fram till september tittar vi på nuvarande år
			      , CONCATENATE("Total lönekostnad ", CONVERT(SELECTEDVALUE(Kalender[År]) + 1, STRING) -- september och framåt är nästkommande år
			))
		displayFolder: FTE
		lineageTag: 97ec581d-769c-41d2-9211-b02c835b57c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Antal FTE Netto' =
			CALCULATE(
			    SUMX(FTE, [Antal FTE Total] * [Antal anställda])
			)
		formatString: 0.0
		displayFolder: FTE
		lineageTag: 140940ce-9923-4ca4-8722-bdd23f7e73dd

	measure 'Total lönekostnad' = ```
			CALCULATE(
			            SUMX(FTE,
			                FTE[Månadslön] * FTE[Antal månader nästa år] * FTE[Tjänstgöringsgrad])  -- summerar alla löner 
			            + 
			            SUMX(
			                FTE, FTE[Tillägg 230] * FTE[Tillägg 230 antal månader nästa år] * FTE[Tjänstgöringsgrad]) --summerar alla lönetillägg kod 230 (oftast bara ett 10-tal)
			)
			            
			```
		formatString: #,0
		displayFolder: FTE
		lineageTag: 5a45af65-6a13-489e-a2b9-3de591698852

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Antal anställda Fryst' = ```
			
			VAR nuvarande_ar = IF(ISBLANK(SELECTEDVALUE(Kalender[År])), YEAR(TODAY()), SELECTEDVALUE(Kalender[År])) -- Denna måste läggas till eftersom man vill att "icke-val" på kalenderdimensionen ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			VAR nuvarande = IF(ISBLANK(SELECTEDVALUE(Kalender[MånadNr])), MONTH(TODAY()), SELECTEDVALUE(Kalender[MånadNr])) -- Denna måste läggas till eftersom man vill att "icke-val" på kalenderdimensionen ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			VAR yearmonth = CONVERT(CONCATENATE(nuvarande_ar, 
			                    CONCATENATE("-", 
			                        CONCATENATE(IF(
			                            nuvarande < 10, CONCATENATE("0", nuvarande), nuvarande), "-01")
			                            )), DATETIME)
			
			-- komplicerad logik för att kunna filtrera bort alla från urvalet som har avgångsdatum innan vald månad. Ytterligare komplext eftersom man vill att "icke-val" på månad ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			-- Nexer rekommenderade att istället ha ett separat mått för ackumulerat utfall eftersom det blir mer användarvänligt än att det byter mellan ackumulerat och månadsutfall beroende på om man valt månad eller inte. Pernilla K instisterade på att "verksamheten vill ha det så". 
			
			RETURN
			
			CALCULATE(
			    DISTINCTCOUNT('Fryst FTE'[ANST_NR]),
			    KEEPFILTERS('Fryst FTE'[Avgångsdatum] > yearmonth || ISBLANK('Fryst FTE'[Avgångsdatum]))
			)
			
			-- John Agebrand, Nexer Insight 2025-04-24
			```
		displayFolder: FTE
		lineageTag: 2ac84dd8-95a1-4a0c-ba67-0b25b002f1c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Antal FTE Fryst' =
			CALCULATE(
			                DIVIDE(
			                    SUM('Fryst FTE'[Tjänstgöringsgrad]) * SUM('Fryst FTE'[Antal månader]), 12, 0
			                    )
			)
		displayFolder: FTE
		lineageTag: 7137a64e-636b-4baa-8c8c-c9b9d43bb0ed

