	measure 'Osäkra hyresfordringar' =
			// Johan Falk 2022-09
			
			VAR Result =
			SUMX('Konto',
			        IF('Konto'[KontoNr] = 1516 || 'Konto'[KontoNr] = 1518,
			              [IB helår] + [Utfall ÅTD],
			             - [IB helår] - [Utfall ÅTD])
			        )
			
			RETURN Result
		formatString: #,0
		displayFolder: Kundreskontra
		lineageTag: d13f490b-4d68-4454-bfe2-0561a0c82928

		changedProperty = FormatString

		changedProperty = IsHidden

