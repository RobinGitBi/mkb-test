	measure 'Beställarlistan ÅTD visa endast framtida datum' = ```
			
			
			// Om filtrerad månad är i samma månad som "Max frysdatum" eller tidigare ska endast Utfall visas, annars ska Utfall plus beställarlistan visas (framtida månader) - NEJ, tillfälligt ändrat till att beställarlistan visas för innevarande månad (sett till dagens datum) och framtida månader)
			
			VAR FirstDayCurrentMonth =  DATE( YEAR(TODAY()), MONTH( TODAY()), 1) 
			//VAR MaxFrystDatumDenSiste = DATE( YEAR(MaxFrystDatum), MONTH( MaxFrystDatum) +1, 1) - 1 // sista dagen månaden med fryst datum
			//VAR MaxFrystDatumDenSiste = DATE( YEAR(TODAY()), MONTH( TODAY()), 1) - 1 // sista dagen föregående månad
			
			VAR MaxDate = MAX(Kalender[Datum])
			
			//VAR UtfallPlusBest = CALCULATE( [Utfall plus beställarlistan], DATESYTD( Kalender[Datum]))
			VAR Best = [Beställarlistan ÅTD] 
			
			VAR Result =
			IF( MaxDate >= FirstDayCurrentMonth,
			    Best,
			    BLANK())
			
			RETURN Result
			```
		formatString: #,0
		displayFolder: Beställarlistan
		lineageTag: 5fa43f74-b789-43c9-85bc-e7a70c967ff6

