	measure 'Beställarlistan ÅTD' =
			// R12 nu...
			
			VAR MaxDate = MAX(Kalender[Datum])
			VAR MaxDateMinusTwelveMonths = DATE(YEAR(MaxDate), MONTH(MaxDate) - 11, 1)  //EDATE(MaxDate, -12)
			
			//VAR Result = CALCULATE( [Beställarlistan], ALL(Kalender), Kalender[Datum] >= DATE(2023,1,1) && Kalender[Datum] <= MaxDate)
			
			VAR Result = CALCULATE( [Beställarlistan], ALL(Kalender), Kalender[Datum] >= MaxDateMinusTwelveMonths && Kalender[Datum] <= MaxDate)
			
			
			Return Result
		formatString: #,0
