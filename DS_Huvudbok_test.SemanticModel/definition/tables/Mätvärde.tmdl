	measure 'Diff %' =
			
			VAR Selection = SELECTEDVALUE('Välj jämförelsemätvärde Personal 2'[Välj jämförelsemätvärde Personal 2])
			
			RETURN
			Selection
			
			-- DIVIDE([Jämförelsevärde Personal Belopp], ROUND([Jämförelsevärde Personal Belopp %], 2), 0)
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Personalkostnader\Diff
		lineageTag: 5ebae8d7-4476-4f75-bdbc-34ccef28ab1d

	measure 'Jämförelsevärde Personal Belopp' =
			
			
			VAR Jamforelsevarde_Personal_1 = // Lagt till mellanslag efter föratt de ska få annorlunda namn än Jämförelsevärde2, annars kommer de få samma färger i stapeldiagram! Ex T0 kommer bli grått vare sig det är jämförelsevärde 1 eller 2.. Detta används i Personalkostnader
			SWITCH(
			    MAX( 'Välj jämförelsemätvärde Personal 1'[Välj jämförelsemätvärde Personal 1 order]),
			        0, [Diff Utfall fg år - T2 fg år Personal],
			        1, [Diff T0 - Utfall fg år],
			        2, [Diff T0 - T2 fg år],
			        3, [Diff T1 - T0 Personal],
			        4, [Diff T2 - T1 Personal],
			        5, [Diff T0 nästa år - T2 Personal]
			)
			
			
			/*
			MAX( 'Välj jämförelsemätvärde Personal 1'[Välj jämförelsemätvärde Personal 1]),
			        "Utfall fg år - T2 fg år", [Diff Utfall fg år - T2 fg år Personal],
			        "T0 - Utfall fg år", [Diff T0 - Utfall fg år],
			        "T0 - T2 fg år", [Diff T0 - T2 fg år],
			        "T1 - T0", [Diff T1 - T0 Personal],
			        "T2 - T1", [Diff T2 - T1 Personal],
			        "T0 nästa år - T2", [Diff T0 nästa år - T2 Personal]
			)
			*/
			RETURN Jamforelsevarde_Personal_1
		formatString: #,0
		displayFolder: Dynamiska jämförelsevärden
		lineageTag: a8e7fc53-9db5-4f36-b724-8d11a3636e69

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Jämförelsevärde Personal Belopp %' =
			
			
			VAR Jamforelsevarde_Personal_2 = // Lagt till mellanslag efter föratt de ska få annorlunda namn än Jämförelsevärde2, annars kommer de få samma färger i stapeldiagram! Ex T0 kommer bli grått vare sig det är jämförelsevärde 1 eller 2.. Detta används i Personalkostnader
			SWITCH(
			    MAX( 'Välj jämförelsemätvärde Personal 1'[Välj jämförelsemätvärde Personal 1 order]),
			        0, [Diff Utfall fg år - T2 fg år Personal %],
			        1, [Diff T0 - Utfall fg år %],
			        2, [Diff T0 - T2 fg år %],
			        3, [Diff T1 - T0 Personal %],
			        4, [Diff T2 - T1 Personal %],
			        5, [Diff T0 nästa år - T2 Personal %]
			)
			
			RETURN Jamforelsevarde_Personal_2
			
			/*
			"T2 fg år", [T2 helår Personal år -1],
			        "Utfall fg år", [Utfall fg år-1 Helår Personal],
			        "T0", [T0 helår Personal],
			        "T1", [T1 helår Personal],
			        "T2", [T2 helår Personal]
			*/
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Dynamiska jämförelsevärden
		lineageTag: d7daf7d2-f9ae-4a80-9c91-2715b20653e3

