	measure 'T0 nästa år helår Personal' = ```
			
			
			VAR SelectedYear = IF(MAX(Kalender[NuvarandeÅr]) = "Nuvarande", MAX(Kalender[År]), SELECTEDVALUE(Kalender[NuvarandeÅr]))
			    -- IF(MAX(Kalender[År med senast stängda månad 11:e]) = "Senast stängda månad", MAX(Kalender[År]), SELECTEDVALUE(Kalender[År med senast stängda månad 11:e]))
			VAR Result = CALCULATE(
			    [T0 helår Personal], 
