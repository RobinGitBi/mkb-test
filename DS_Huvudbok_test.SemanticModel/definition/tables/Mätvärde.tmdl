			VAR Jmf2 = [Valt jämförelsevärde2]
			VAR Diff = [Diff Jämförelsevärde1 mot Jämförelsevärde2]
			
			VAR LastClosedDate = CALCULATE( MAX( Kalender[Datum]), Kalender[Stängd månad] = "Stängd månad", ALL(Kalender))
			
			//VAR Result = "Detta visar skillnaden mellan " & Jmf1 & " och " & Jmf2 & " per " & FORMAT(LastClosedDate, "YYYY-MM-DD") & ", d.v.s. " & FORMAT([Jämförelsevärde1], "### ### ###") & " - (" & FORMAT([Jämförelsevärde2], "### ### ### ") & ") = " & FORMAT(Diff, "### ### ###") & " kr"
			
			VAR Result = "Detta visar skillnaden mellan faktiskt utfall plus kända kostnader i beställarlistan och aktuell prognos " & Jmf2 & " per " & FORMAT(LastClosedDate, "YYYY-MM-DD") & ", d.v.s. " & FORMAT([Utfall plus beställarlistan ÅTD], "### ### ###") & " - (" & FORMAT([Jämförelsevärde2], "### ### ### ") & ") = " & FORMAT(Diff, "### ### ###") & " kr"
			
			VAR ResultOmStandardIsFiltered = IF( [Valda jämförelsevärden är standard 1 annars 0] = 1, Result, " ")
			
			RETURN Result
			
			-- ResultOmStandardIsFiltered
		isHidden
		displayFolder: Conditional formatting
