	measure Jämförelsevärde1 =
			
			
			VAR Jamforelsevarde1 = // Lagt till mellanslag efter föratt de ska få annorlunda namn än Jämförelsevärde2, annars kommer de få samma färger i stapeldiagram! Ex T0 kommer bli grått vare sig det är jämförelsevärde 1 eller 2..
