			VAR MonthToday = MONTH(TODAY())
			
			VAR Diff= [Diff Jämförelsevärde1 mot Jämförelsevärde2]
			
			VAR Result = 
			IF( Diff < 0,
			    "#FF8F8F", // rött //     "#FFED97",// gult
			    "#7EFF7E") // grönt
			
			VAR ResultOmStandardIsFiltered = IF( [Valda jämförelsevärden är standard 1 annars 0] = 1, Result, "#E6E6E6")
			
			RETURN Result
