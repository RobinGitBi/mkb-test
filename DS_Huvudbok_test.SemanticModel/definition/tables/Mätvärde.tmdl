	measure 'Inforuta 1' =
			
			
			VAR Jmf1 = [Valt jämförelsevärde1]
			VAR Jmf2 = [Valt jämförelsevärde2]
			VAR Diff = [Diff Jämförelsevärde1 mot Jämförelsevärde2]
			
			/*
			VAR ResultUnder = "Per " & [Valt maxdatum] & " ligger " & Jmf1 & " " & FORMAT(ABS(Diff), "### ### ##0") & " kr under " & Jmf2
			VAR ResultAbove = "Per " & [Valt maxdatum] & " ligger " & Jmf1 & " " & FORMAT(ABS(Diff), "### ### ##0") & " kr över " & Jmf2
			*/
			
			VAR ResultUnder = "Per " & [Valt maxdatum] & " ligger du " & FORMAT(ABS(Diff), "### ### ###") & " kr under prognos"
			VAR ResultAbove = "Per " & [Valt maxdatum] & " ligger du " & FORMAT(ABS(Diff), "### ### ###") & " kr över prognos"
			
			VAR Result = IF( Diff > 0, ResultUnder, ResultAbove)
			
			VAR ResultOmStandardIsFiltered = IF( [Valda jämförelsevärden är standard 1 annars 0] = 1, Result, " ")
			
			RETURN Result
			
			-- ResultOmStandardIsFiltered /*Den här är borttagen eftersom Standard inte används längre*/
		isHidden
		displayFolder: Conditional formatting
		lineageTag: 9ea64287-c491-43a2-9620-45880716ac0a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inforuta 2' =
			
			
			VAR Jmf1 = [Jämförelsevärde1]
			VAR Jmf2 = CALCULATE( [Jämförelsevärde2], ALLEXCEPT( Kalender, Kalender[År med senast stängda månad 11:e]))
			VAR Diff = Jmf1 - Jmf2
			
			VAR ResultUnder = "Du har " & FORMAT(ABS(Diff), "### ### ###") & " kr i beställningsutrymme kvar detta år"
			VAR ResultAbove = "Du har överskridit ditt beställningsutrymme detta år"
			
			VAR Result = IF( Diff > 0, ResultUnder, ResultAbove)
			
			VAR ResultOmStandardIsFiltered = IF( [Valda jämförelsevärden är standard 1 annars 0] = 1, Result, " ")
			
			RETURN Result
			
			-- ResultOmStandardIsFiltered /*Den här är borttagen eftersom Standard inte används längre*/
		isHidden
