	measure 'Valda standardmätvärden' = ```
			
			
			VAR MonthToday = MONTH(TODAY())
			
			VAR ChooseMeasures = 
			IF( (MonthToday >= 11 || MonthToday <= 1),
			    "Utfall mot T2",
			    IF( MonthToday >= 2 && MonthToday < 4,
			        "Utfall mot T0",
			        IF( MonthToday >= 4 && MonthToday < 8,
			            "Utfall mot T1",
			            IF( MonthToday >= 8 && MonthToday < 10,
			                "Utfall mot T2",
			                IF( MonthToday = 10,
			                    "T0 nästa år mot T2")))))
			
			RETURN ChooseMeasures
