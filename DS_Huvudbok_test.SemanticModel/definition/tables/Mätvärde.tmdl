	measure 'Antal FTE Månad Fryst' = ```
			-- den här summerar Utfall FTE korrekt per månad. Filtrerar ut alla med anställningsdatum i framtiden och sätter 0 på dem
			
			VAR CurrentDate = MAX(Kalender[Datum])
			VAR CurrentMonthStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			VAR monthend = EOMONTH(MAX('Fryst FTE'[Frysdatum]), 0)
			VAR sysselsattning = AVERAGE('Fryst FTE'[Tjänstgöringsgrad])
			VAR nuvarande_ar = IF(ISBLANK(SELECTEDVALUE(Kalender[År])), YEAR(TODAY()), SELECTEDVALUE(Kalender[År])) -- Denna måste läggas till eftersom man vill att "icke-val" på kalenderdimensionen ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			VAR nuvarande = IF(ISBLANK(SELECTEDVALUE(Kalender[MånadNr])), MONTH(TODAY()), SELECTEDVALUE(Kalender[MånadNr])) -- Denna måste läggas till eftersom man vill att "icke-val" på kalenderdimensionen ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			VAR yearmonth = CONVERT(CONCATENATE(nuvarande_ar, 
			                    CONCATENATE("-", 
			                        CONCATENATE(IF(
			                            nuvarande < 10, CONCATENATE("0", nuvarande), nuvarande), "-01")
			                            )), DATETIME)
			
			-- komplicerad logik för att kunna filtrera bort alla från urvalet som har avgångsdatum innan vald månad. Ytterligare komplext eftersom man vill att "icke-val" på månad ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			-- Nexer rekommenderade att istället ha ett separat mått för ackumulerat utfall eftersom det blir mer användarvänligt än att det byter mellan ackumulerat och månadsutfall beroende på om man valt månad eller inte. Pernilla K instisterade på att "verksamheten vill ha det så". 
			
			RETURN
			    CALCULATE(
			        SUMX(
			            FILTER(
			                'Fryst FTE',
			                'Fryst FTE'[Anställningsdatum] <= monthend &&
			                (ISBLANK('Fryst FTE'[Avgångsdatum]) || 'Fryst FTE'[Avgångsdatum] >= CurrentMonthStart)
			                ),
			            'Fryst FTE'[Antal FTE månad] * sysselsattning
			            )
			            )
			```
		displayFolder: FTE
		lineageTag: dbb63be1-7d4b-406b-a57f-314cdafaeceb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Antal FTE månad ack' = ```
			-- korrigerad 2025-05-21 av John Agebrand, efter samråd med Robin Uppman. Antal FTE Månad Fryst 2 är en SUMMARIZE för att tvinga in alla rader 
			
			VAR current_month = [Antal FTE Månad Fryst 2]
			VAR CurrentDate = MAX(Kalender[Datum])
			VAR antal_valda_manader = MAX(Kalender[MånadNr]) -- denna används för att göra månadsvalet dynamiskt
			VAR nuvarande_ar = IF(ISBLANK(SELECTEDVALUE(Kalender[År])), YEAR(TODAY()), SELECTEDVALUE(Kalender[År])) -- Denna måste läggas till eftersom man vill att "icke-val" på kalenderdimensionen ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			VAR nuvarande = IF(ISBLANK(SELECTEDVALUE(Kalender[MånadNr])), MONTH(TODAY()), SELECTEDVALUE(Kalender[MånadNr])) -- Denna måste läggas till eftersom man vill att "icke-val" på kalenderdimensionen ska innebära ackumulerat utfall, men val av månad ska vara utfall på månad.
			VAR yearmonth = CONVERT(CONCATENATE(nuvarande_ar, 
			                    CONCATENATE("-", 
			                        CONCATENATE(IF(
			                            nuvarande < 10, CONCATENATE("0", nuvarande), nuvarande), "-01")
			                            )), DATETIME)
			RETURN
			
			IF(nuvarande > MAX('Fryst FTE'[Frysdatum]), BLANK(),
			
			DIVIDE(
			    CALCULATE(
			        SUMX(
			            FILTER(
			                ALL(Kalender),
			                Kalender[Datum] <= CurrentDate
			            ),
			            [Antal FTE Månad Fryst 2]
			        )
			    ),
			    CALCULATE(
			        COUNTROWS(
			            FILTER(
			                ALL(Kalender),
			                Kalender[Datum] <= CurrentDate &&
			                NOT(ISBLANK([Antal FTE Månad Fryst 2]))
			            )
			        )
			    )
			)
			)
			/*
			Antal FTE månad ack = 
			VAR current_month = [Antal FTE Månad Fryst]
			VAR antal_valda_manader = MAX(Kalender[MånadNr]) -- denna används för att göra månadsvalet dynamiskt
			            VAR yearmonth = CONVERT(CONCATENATE(SELECTEDVALUE(Kalender[År]), 
			                    CONCATENATE("-", 
			                        CONCATENATE(IF(SELECTEDVALUE(Kalender[MånadNr]) < 10, CONCATENATE("0", SELECTEDVALUE(Kalender[MånadNr])), SELECTEDVALUE(Kalender[MånadNr])), "-01")
			            )), DATETIME)
			
			RETURN 
			CALCULATE(
			IF(
			    NOT ISBLANK([Antal FTE Månad Fryst]),
			    -- DIVIDE(SUMX('Fryst FTE', [Antal FTE Månad Fryst]), antal_valda_manader, 1), -- Summerar rätt på totalen över flera månader
			    DIVIDE(TOTALYTD([Antal FTE Månad Fryst], Kalender[Datum]), antal_valda_manader, 1),
			    BLANK()
			)
			--, KEEPFILTERS(CONVERT('Fryst FTE'[Avgångsdatum], DATETIME) < yearmonth || ISBLANK('Fryst FTE'[Avgångsdatum]))
			)
			*/
			```
		displayFolder: FTE
		lineageTag: 49bbb4f1-fd09-49f7-a837-874aba1513ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Antal valda månader' = DISTINCTCOUNT(Kalender[Månad])
