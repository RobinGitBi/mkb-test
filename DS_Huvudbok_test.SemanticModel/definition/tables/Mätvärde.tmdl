	measure 'Utfall FTE Månad ack TEST' = ```
			
			VAR current_month = [Antal FTE Månad Fryst]
			VAR antal_valda_manader = MAX(Kalender[MånadNr]) -- denna används för att göra månadsvalet dynamiskt
			VAR start_of_month = CONVERT(CONCATENATE(SELECTEDVALUE(Kalender[År]), 
			            CONCATENATE("-", 
			            CONCATENATE(IF(SELECTEDVALUE(Kalender[MånadNr]) < 10, CONCATENATE("0", SELECTEDVALUE(Kalender[MånadNr])), SELECTEDVALUE(Kalender[MånadNr])), "-01")
			            )), DATETIME)
			VAR no_of_months = MAX(Kalender[MånadNr])
			VAR SelectedYear = MAX(Kalender[År])
			VAR SelectedMonth = MAX(Kalender[MånadNr])
			
			RETURN 
			
			CALCULATE(
			    TOTALYTD(
			        SUMX(
			            'Fryst FTE',
			            VAR StartMonth = MONTH('Fryst FTE'[Anställningsdatum])
			            VAR StartYear = YEAR('Fryst FTE'[Anställningsdatum])
			            VAR EndMonth = MONTH('Fryst FTE'[Avgångsdatum])
			            VAR EndYear = YEAR('Fryst FTE'[Avgångsdatum])
			            
			
			            RETURN 
			            
			            IF(
			                -- Employee is still active in the selected period
			                (ISBLANK('Fryst FTE'[Avgångsdatum]) || CONVERT('Fryst FTE'[Avgångsdatum], DATETIME)  < CONVERT('Fryst FTE'[Frysdatum], DATETIME))
			                && CONVERT('Fryst FTE'[Anställningsdatum], DATETIME) < start_of_month , 
			                current_month * AVERAGE('Fryst FTE'[Tjänstgöringsgrad]),                
			                -- [Antal FTE Månad Fryst], 
			                0
			            )
			          
			            
			        ),
			        Kalender[Datum]
			    ) / no_of_months
			    -- , KEEPFILTERS(Kalender[År] = SelectedYear)
			)
			```
		formatString: 0.0
		displayFolder: FTE
		lineageTag: fab54331-bcdc-4443-b1d4-2b8ccc8edd8d

	measure 'FTE YTD' = ```
			-- Filtrerar ut alla med anställningsdatum i framtiden och sätter 0 på dem
			VAR startdate = CONVERT(CONCATENATE(SELECTEDVALUE(Kalender[År]), "-01-01"), DATETIME)    
			VAR monthno = SELECTEDVALUE(Kalender[MånadNr])
			
			RETURN
			
			DIVIDE(
			    CALCULATE(
			    SUMX('Fryst FTE',
			        IF(ISBLANK('Fryst FTE'[Avgångsdatum]) ||  
			        -- CONVERT(MAX('Fryst FTE'[Avgångsdatum]), DATETIME) > STARTOFMONTH(Kalender[Datum])
			        CONVERT('Fryst FTE'[Avgångsdatum], DATETIME) > STARTOFMONTH(Kalender[Datum])
			            , [Antal FTE Månad Fryst], 0)
			    )
			    , DATESYTD(Kalender[Datum])
			    , KEEPFILTERS('Fryst FTE'[Frysdatum] > startdate)
			    )
			    
			, monthno, 0)
			```
		formatString: 0.00
		displayFolder: FTE
