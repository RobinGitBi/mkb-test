	measure 'Beställarlistan 11 mån bak till slutet på året' = ```
			
			
			VAR FirstDayCurrentMonth =  DATE( YEAR(TODAY()), MONTH(TODAY()), 1)
			VAR LastDayCurrentYear =  DATE( YEAR(FirstDayCurrentMonth), 12, 31) 
			VAR FirstDay11MonthsBack =  EDATE(FirstDayCurrentMonth, -11)
			
			VAR Result = CALCULATE([Beställarlistan], ALL(Kalender), Kalender[Datum] >= FirstDay11MonthsBack && Kalender[Datum] <= LastDayCurrentYear)
			
			RETURN Result
			```
		formatString: #,0
		displayFolder: Beställarlistan
		lineageTag: d7dcd54f-efa7-418a-8aef-c8454e5af32e

