	measure 'Yta prognos total' =
			// hette "Yta fryst" tidigare
			
			VAR MaxSelectedPeriod = MAX(Kalender[Datum])
			
			RETURN CALCULATE( SUM('Yta per segment och kostnadsställe'[PrognosTotalYta]), Kalender[Datum] = MaxSelectedPeriod)
