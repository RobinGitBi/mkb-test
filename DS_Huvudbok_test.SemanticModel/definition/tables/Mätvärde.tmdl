	measure 'Prognos Utfall ÅTD (Ack) Personal' =
			
			VAR CurrentDate = TODAY()
			VAR CurrentYear = YEAR(CurrentDate)
			VAR CurrentMonth = MONTH(CurrentDate)
			
			VAR ActualYTD = [Utfall ÅTD (Ack) Personal]
			VAR MonthsElapsed = MONTH(TODAY())
			VAR AveragePerMonth = DIVIDE(ActualYTD, MonthsElapsed, 0)
			VAR RemainingMonths = 12 - MonthsElapsed
			VAR ForecastSales = AveragePerMonth * RemainingMonths
			
			RETURN
			ForecastSales
			
			/*
			IF(
			    YEAR(MAX('Kalender'[Datum])) = CurrentYear,
			    IF(
			        MONTH(MAX(Kalender[Datum])) <= CurrentMonth, ActualYTD, -- Show actual YTD for past and current months
			        ActualYTD + ForecastSales -- Show forecasted values for future months
			    ), CALCULATE([Utfall ÅTD (Ack) Personal]) -- Show full YTD for previous years
			)
			
			*/
			
			/*
			VAR MonthsElapsed = MONTH(TODAY())
			VAR AveragePerMonth = DIVIDE([Utfall ÅTD (Ack) Personal], MonthsElapsed, 0)
			VAR RemainingMonths = 12 - MonthsElapsed
			VAR ProjectedSales = AveragePerMonth * RemainingMonths
			
			RETURN
			    IF(
			    YEAR(MAX(Kalender[Datum])) = YEAR(TODAY()) && MAX(Kalender[Datum]) < TODAY(),
			    BLANK(),
			    [Utfall ÅTD (Ack) Personal] + ProjectedSales
			    )
			*/
		formatString: #,0
		displayFolder: Personalkostnader\Utfall
		lineageTag: 04dd52d1-f281-44c8-a19c-7f811dc53c71

		annotation PBI_FormatHint = {"isDecimal":true}

