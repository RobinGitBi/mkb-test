	measure 'Titel med RRLev1namn diff fg år ÅTD' = ```
			
			
			VAR MonthToday = MONTH(TODAY())
			VAR Diff= [Diff Jämförelsevärde1 mot Jämförelsevärde2 %]
			
			VAR CheckIfZero = IF( Diff > -0.005 && Diff < 0.005, 1, 0)
			
			VAR DiffFormatted = 
			    IF( Diff > 0, "+" & FORMAT(Diff*100, "#"), FORMAT(Diff*100, "#") )
			    & " %"
			
			VAR Result = 
			IF( CheckIfZero = 1,
			    MAX(Konto[RRLev1Namn]) & " 0 %",
			    MAX(Konto[RRLev1Namn]) & " " &  DiffFormatted)
			
			RETURN Result
			
			```
		isHidden
		displayFolder: Conditional formatting\Resultatuppföljning
		lineageTag: b712b7f8-0232-4c77-ab1f-f0cfb0569366

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Titel med PnLDescr diff fg år ÅTD' = ```
			
			
			VAR MonthToday = MONTH(TODAY())
			
			VAR Diff=
			SWITCH( MAX( 'Välj jämförelsemätvärde Finans'[Välj jämförelsemätvärde]),
			    "T0", [Utfall / T0 ÅTD],
			    "T1", [Utfall / T1 ÅTD],
			    "T2", [Utfall / T2 ÅTD],
			    "Fg år", [Utfall / Utfall fg år-1 ÅTD])
			
			VAR Result = 
			IF( Diff > 0,
			    MAX(PNLStructure[PNLDescr]) & " +" &  FORMAT(Diff*100, "#") & " %",
			    MAX(PNLStructure[PNLDescr]) & " " &  FORMAT(Diff*100, "#") & " %")
			
			RETURN Result
			
			
			```
		isHidden
		displayFolder: Conditional formatting\Resultatuppföljning
		lineageTag: de0f6a76-f240-4996-b1b6-ec0207de1b8c

		changedProperty = IsHidden

