			    -- Kalender[År med senast stängda månad 11:e] = CONVERT(SelectedYear + 1, STRING),
			
			    KEEPFILTERS(PNLStructure[RowIndex] = 5), -- "TB2 Omkostnader"
			    KEEPFILTERS(Konto[RRLev1Id] = 71) -- "Utgifter/kostnader för personal")
			                )
			
			RETURN Result
			
