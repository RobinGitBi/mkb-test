	measure 'Diff Belopp' = ```
			
			
			VAR Selection = SELECTEDVALUE('Välj jämförelsemätvärde Personal 1'[Välj jämförelsemätvärde Personal 1])
			
			RETURN
			Selection
			/*
			    
			    SWITCH(
			        TRUE(),
			        Selection = "Utfall fg år - T2 fg år", [Diff Utfall fg år - T2 fg år Personal],
			        Selection = "T0 - Utfall fg år", [Diff T0 - Utfall fg år],
			        Selection = "T0 - T2 fg år", [Diff T0 - T2 fg år],
			        Selection = "T1 - T0", [Diff T1 - T0 Personal],
			        Selection = "T2 - T1", [Diff T2 - T1 Personal],
			        Selection = "T0 nästa år - T2", [Diff T0 nästa år - T2 Personal],
			        BLANK()  -- Default if no valid selection
			    )
			*/
			-- [Jämförelsevärde Personal 1] - [Jämförelsevärde Personal 2]
			```
		displayFolder: Personalkostnader\Diff
