	measure 'Osäkra hyresfordringar fg år' =
			
			VAR MaxDate = MAX( Kalender[Datum])
			
			VAR Utfall = CALCULATE( [Utfall ÅTD], DATEADD(Kalender[Datum], -1, YEAR))
			
			VAR IB = [IB fg år-1]
			
			VAR Result =
			SUMX('Konto',
			        IF('Konto'[KontoNr] = 1516,
			              IB + Utfall,
			             - IB - Utfall
			        ))
			
			RETURN Result
