	measure 'Antal anställda månad ack' = ```
			-- ska visa antalet anställda ackumulerat för varje månad. Delar antalet ackumulerade anställda med antalet månader som passerat
			VAR antal_valda_manader = DISTINCTCOUNT(Kalender[MånadNr]) -- denna används för att göra månadsvalet dynamiskt
			VAR yearmonth = CONVERT(CONCATENATE(SELECTEDVALUE(Kalender[År]), 
			                    CONCATENATE("-", 
			                        CONCATENATE(IF(SELECTEDVALUE(Kalender[MånadNr]) < 10, CONCATENATE("0", SELECTEDVALUE(Kalender[MånadNr])), SELECTEDVALUE(Kalender[MånadNr])), "-01")
			)), DATETIME)
			-- komplicerad logik för att kunna filtrera bort alla från urvalet som har avgångsdatum innan vald månad
			
			RETURN
			IF(antal_valda_manader > 1, 
			DIVIDE(
			    CALCULATE(
			    TOTALYTD(DISTINCTCOUNT('Fryst FTE'[ANST_NR]), Kalender[Datum]),
			    KEEPFILTERS(CONVERT('Fryst FTE'[Avgångsdatum], DATETIME) > MIN(Kalender[Datum]) || ISBLANK('Fryst FTE'[Avgångsdatum]))
			), antal_valda_manader, 0)
			,
			CALCULATE(
			    TOTALYTD(DISTINCTCOUNT('Fryst FTE'[ANST_NR]), Kalender[Datum]),
			    KEEPFILTERS(CONVERT('Fryst FTE'[Avgångsdatum], DATETIME) > yearmonth || ISBLANK('Fryst FTE'[Avgångsdatum]))
			)
			)
			
			/*
			IF(
			    NOT ISBLANK([Antal FTE Månad Fryst]),
			    DIVIDE(TOTALYTD([Antal FTE Månad Fryst], Kalender[Datum]), antal_valda_manader, 1),
			    BLANK()
			)
			*/
			```
		formatString: 0
		displayFolder: FTE
		lineageTag: 2a67a7a2-93e3-4e99-846e-9cbc7006a2f4

		annotation PBI_FormatHint = {"isDecimal":true}

