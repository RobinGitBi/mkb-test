	measure 'Antal sjuka i period' = ```
			
			    CALCULATE(
			        DISTINCTCOUNT('Frånvaro'[Anstnr]),
			        FILTER(
			            'Frånvaro',
			             'Frånvaro'[Datum] <= MAX(Kalender[Datum])
			                && 'Frånvaro'[Datum] >= MIN(Kalender[Datum])
			        )
			    )
			```
		formatString: 0
		displayFolder: Frånvaro
		lineageTag: 9b6868c7-3ba7-432a-97d9-72969ce42891

	measure 'Antal anställningsdagar i vald period' = ```
			
			
			VAR Result = 
			SUMX( Kalender,
			    VAR RelevantDate = Kalender[Datum]
			    VAR RowsRelevantDate = 
			        CALCULATE( COUNTROWS( 'Anställningar'), 
			                        'Anställningar'[GiltigFrån] <= RelevantDate && 'Anställningar'[GiltigTill] >= RelevantDate)
			    RETURN RowsRelevantDate
			    )
			
			
			RETURN Result
			
			```
		formatString: #,0
		displayFolder: Anställda
		lineageTag: 0fef9661-d892-4020-808a-68001e6c6de6

	measure 'Antal sjukdagar i period' = ```
			
			
			VAR Result = 
			SUMX( Kalender,
			    VAR RelevantDate = Kalender[Datum]
			    VAR RowsRelevantDate = 
			        CALCULATE( COUNTROWS( 'Frånvaro') * DIVIDE( MAX( 'Frånvaro'[Procent]  ), 100) , 
			                        'Frånvaro'[Datum] = RelevantDate)
			    RETURN RowsRelevantDate
			    )
			
			
			RETURN Result
			```
		formatString: 0
		displayFolder: Frånvaro
		lineageTag: 3637bd39-e7e6-40de-b493-3d2973feddfa

