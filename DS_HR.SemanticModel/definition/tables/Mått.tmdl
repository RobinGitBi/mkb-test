		lineageTag: b2580ee5-e671-4410-a822-bdb6bd735a8a

	measure 'Antal medarbetare' =
			
			DISTINCTCOUNT( 'Anställningar'[Anställningsnummer] )
		formatString: 0
		displayFolder: Anställda
		lineageTag: b3bacf9a-4fe9-4476-bdfa-075009435ffe

	measure 'Antal medarbetare sista dag på året' =
			
			--Count of employees from last day of the selected year where GiltigTill is on or after the last day and GiltigFrån is on the same day or earlier.
			
			CALCULATE(
			    [Antal medarbetare],
			    FILTER( 'Anställningar', 'Anställningar'[GiltigTill] >= ENDOFYEAR( Kalender[Datum] ) && 'Anställningar'[GiltigFrån] <= ENDOFYEAR( Kalender[Datum] ) )
			)
		formatString: 0
		displayFolder: Anställda
		lineageTag: cb1a0af1-b7dd-463e-bf97-aca295a77419

	measure 'Antal arbetade timmar timanställda' =
			
			SUM( 'Timanställningar'[Antal] )
		displayFolder: Anställda
		lineageTag: 3673aaad-d068-4cb6-a5e5-434f3e130478

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Medelålder slutet av vald period' =
			
			
			-- Why does datediff not provide decimals? That's the reason we calculate days
			var dagar = CALCULATE(
			    AVERAGEX( Personer, DATEDIFF( Personer[Födelsedatum], MAX( Kalender[Datum] ), DAY ) ),
			    FILTER( 'Anställningar', 'Anställningar'[GiltigTill] >= ENDOFYEAR( Kalender[Datum] ) && 'Anställningar'[GiltigFrån] <= ENDOFYEAR( Kalender[Datum] ) )
			)
			
			return DIVIDE( dagar, 365 )
		displayFolder: Anställda
		lineageTag: c4646161-523f-423a-a2cc-29ae70edbb97

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Medelantal timavlönade' =
			
			[Antal arbetade timmar timanställda] / (165 * 12)
		formatString: 0.00
		displayFolder: Anställda
		lineageTag: d4513701-0531-4ed7-a883-f652e24d4e67

