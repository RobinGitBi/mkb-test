	measure 'Antal tillsvidareanställda som slutat' =
			
			CALCULATE(
			    [Antal medarbetare],
			    FILTER( 'Anställningsform', 'Anställningsform'[Anställningsform] in { "Tillsvidareanställning", "Provanställning", "Trainee" }),
			    FILTER( 'Anställningar', ( STARTOFYEAR( Kalender[Datum] ) <= 'Anställningar'[GiltigTill] && 'Anställningar'[GiltigTill] <= ENDOFYEAR( Kalender[Datum] ) ) && 'Anställningar'[Avgångsorsak] <> BLANK() )
			)
		formatString: 0
		displayFolder: Anställda
