	measure 'Antal sjukdagar i period anonym' = ```
			
			/*
			VAR Result = 
			SUMX( Kalender,
			    VAR RelevantDate = Kalender[Datum]
			    VAR RowsRelevantDate = 
			        CALCULATE( COUNTROWS( 'FrånvaroHashed'), 
			                        'FrånvaroHashed'[Fomdatum] <= RelevantDate && 'FrånvaroHashed'[Tomdatum] >= RelevantDate)
			    RETURN RowsRelevantDate
			    )
			
			
			RETURN Result
			*/
			VAR Result = 
			SUMX( Kalender,
			    VAR RelevantDate = Kalender[Datum]
			    VAR RowsRelevantDate = 
			        CALCULATE( COUNTROWS( 'FrånvaroHashed') * DIVIDE( MAX( 'FrånvaroHashed'[Procent]  ), 100) , 
			                        'FrånvaroHashed'[Datum] = RelevantDate)
			    RETURN RowsRelevantDate
			    )
			
			
			RETURN Result
			```
		displayFolder: Hashat
		lineageTag: f84906b7-a148-4e51-97d2-75427301f6de

