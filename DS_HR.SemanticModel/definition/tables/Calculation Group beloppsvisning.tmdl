table 'Calculation Group beloppsvisning'
	lineageTag: 66357056-2506-41cf-a7d4-4c60b5e25662

	calculationGroup
		precedence: 1

		calculationItem 'Visa i ental' = SELECTEDMEASURE()

		calculationItem 'Visa i tusental' =
				IF(
				    RIGHT(SELECTEDMEASURENAME(), 1) = "%" || CONTAINSSTRING(SELECTEDMEASURENAME(), "/"), // om valt measure slutar med procent vill vi inte ändra formatet (någon diff i % exempelvis)
				    SELECTEDMEASURE(),
				    SELECTEDMEASURE() / 1000
				    )

		calculationItem 'Visa i miljontal' = ```
				IF(
				    RIGHT(SELECTEDMEASURENAME(), 1) = "%" || CONTAINSSTRING(SELECTEDMEASURENAME(), "/"), // om valt measure slutar med procent vill vi inte ändra formatet (någon diff i % exempelvis)
				    SELECTEDMEASURE(),
				    SELECTEDMEASURE() / 1000000
				    )
				
				
				
				```

