model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: sv-SE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Fact

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["Personer","Timanställningar","Anställningar","Medellöner","Mått","Kalender","AnnualFTE","Anställningsform","Huvudbok","Konto","PNLStructure","Dokument","Totala temperaturer per fråga","Tillbud och incidenter","Massage på jobbet","Friskvårdsbidrag","Frågor","FrånvaroHashed","Personer_Hashed","Anställningar_Hashed","Frånvaro","Löner","Feriejobb","Jobbkanaler","JobbKlassificering","Organisationer","Organisationstyper","Personklassificering","Gårdsvärdar","Vab","ViewDimAnställdSCD2","ViewDimAnstalldAldersIntervall","ViewDimSjukskrivningstyp"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation __TEdtr = 1

annotation PBI_ProTooling = ["WebModelingEdit","DaxQueryView_Desktop","DevMode"]

ref table Personer
ref table Timanställningar
ref table Anställningar
ref table Medellöner
ref table Mått
ref table Kalender
ref table AnnualFTE
ref table Anställningsform
ref table Huvudbok
ref table Konto
ref table PNLStructure
ref table 'Calculation Group resultaträkning'
ref table 'Calculation Group beloppsvisning'
ref table 'Calculation Group time intelligence'
ref table Dokument
ref table 'Totala temperaturer per fråga'
ref table 'Tillbud och incidenter'
ref table 'Massage på jobbet'
ref table Friskvårdsbidrag
ref table Frågor
ref table FrånvaroHashed
ref table Personer_Hashed
ref table Anställningar_Hashed
ref table Frånvaro
ref table Löner
ref table Feriejobb
ref table Jobbkanaler
ref table JobbKlassificering
ref table Organisationer
ref table Organisationstyper
ref table Personklassificering
ref table Gårdsvärdar
ref table Vab
ref table ViewDimAnställdSCD2
ref table ViewDimAnstalldAldersIntervall
ref table ViewDimSjukskrivningstyp

ref cultureInfo en-US

