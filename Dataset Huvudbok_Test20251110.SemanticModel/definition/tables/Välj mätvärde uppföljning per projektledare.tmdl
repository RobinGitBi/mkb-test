	column Grupp = ```
			
			VAR Order_ = 'Välj mätvärde uppföljning per projektledare'[Välj mätvärde uppföljning per projektledare Order]
			VAR Result =
			IF( Order_ < 10,
			    "Prognos RR/BR",
			                   
			                    IF( Order_ >= 100 && Order_ < 110,
			                        "Aktuell prognos",
			                        IF( Order_ >= 110 && Order_ < 120,
			                            "T0",
			                            IF( Order_ >= 120 && Order_ < 130,
			                                "T0 nästa år",
			                                IF( Order_ >= 130 && Order_ < 140,
			                                    "T1",
			                                    IF( Order_ >= 140 && Order_ < 150,
			                                        "T2",
			                                        BLANK()))))))
			 
			RETURN Result
			```
		lineageTag: 5dfe20b0-e52c-437b-882a-b634a1cbe636
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

